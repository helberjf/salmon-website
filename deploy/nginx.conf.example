# Configuração de exemplo do Nginx para o website (SPA estática).
# Ajuste server_name e root conforme o seu ambiente.

server {
    listen 80;
    listen [::]:80;
    server_name seudominio.com.br www.seudominio.com.br;
    server_tokens off;

    root /var/www/salmon-website;
    index index.html;
    charset utf-8;

    # Rotas conhecidas usam HTML estático com metadados localizados.
    # Rotas desconhecidas exibem a página SPA de erro e mantêm o status HTTP 404.
    location / {
        try_files $uri.html $uri $uri/ =404;
        error_page 404 /index.html;
    }

    # O HTML deve ser revalidado para que novos deploys apareçam imediatamente.
    location = /index.html {
        expires -1;
    }

    # Cache longo para assets com hash no nome
    location ^~ /assets/ {
        expires 1y;
    }

    # Fotografias do catálogo mantêm cache moderado, pois os nomes não têm hash.
    location ~* \.(?:avif|webp|png|jpe?g|svg|ico)$ {
        expires 30d;
    }

    location ~* \.woff2?$ {
        expires 1y;
    }

    # Compressão
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json application/xml image/svg+xml;
    gzip_min_length 1024;

    # Cabeçalhos de segurança básicos
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "base-uri 'self'; frame-ancestors 'self'; object-src 'none'" always;
}
