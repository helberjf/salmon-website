# Configuracao HTTP de bootstrap do Nginx para o website estatico.
# Ajuste server_name e root. Depois de emitir o certificado, substitua esta
# configuracao por nginx.tls.conf.example. HSTS nao deve ser enviado por HTTP.

server {
    listen 80;
    listen [::]:80;
    server_name seudominio.com.br www.seudominio.com.br;
    server_tokens off;

    root /var/www/salmon-website;
    index index.html;
    charset utf-8;

    # Alias historico: redirecionamento permanente para a rota canonica.
    location ~ ^/norwell/?$ {
        return 308 /a-norwell$is_args$args;
    }

    location ~ ^/(pt|en|es|no)/norwell/?$ {
        return 308 /$1/a-norwell$is_args$args;
    }

    # Rotas conhecidas usam HTML estático com metadados localizados.
    # Rotas desconhecidas exibem a página SPA de erro e mantêm o status HTTP 404.
    location / {
        try_files $uri.html $uri $uri/ =404;
        error_page 404 /index.html;
    }

    # O HTML deve ser revalidado para que novos deploys apareçam imediatamente.
    location = /index.html {
        expires -1;
    }

    # Cache longo para assets com hash no nome
    location ^~ /assets/ {
        expires 1y;
    }

    # Fotografias do catálogo mantêm cache moderado, pois os nomes não têm hash.
    location ~* \.(?:avif|webp|png|jpe?g|svg|ico)$ {
        expires 30d;
    }

    location ~* \.woff2?$ {
        expires 1y;
    }

    # Compressão
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json application/xml image/svg+xml;
    gzip_min_length 1024;

    # Cabecalhos de seguranca. HSTS fica somente no terminador HTTPS.
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Origin-Agent-Cluster "?1" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), publickey-credentials-get=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; child-src 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'" always;
}
