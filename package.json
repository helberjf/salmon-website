{
  "name": "salmon-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-static-assets.mjs && tsc -p tsconfig.json --noEmit && vite build && node scripts/generate-route-html.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "verify:assets": "node scripts/verify-static-assets.mjs",
    "verify:infra": "node scripts/verify-infrastructure.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "framer-motion": "^11.15.0",
    "gsap": "3.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "wouter": "^3.3.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
